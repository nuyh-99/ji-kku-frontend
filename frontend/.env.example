# Ji-kku 프론트엔드(Next.js) 환경변수 예시
# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요.
# Next.js는 NEXT_PUBLIC_ 접두사가 붙은 변수만 브라우저에 노출합니다.
# (접두사가 없으면 서버 사이드에서만 접근 가능)

# 백엔드 API 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 카카오 지도 SDK 키 (명소추천 화면용)
# 카카오 개발자센터(developers.kakao.com)에서 JavaScript 키 발급
NEXT_PUBLIC_KAKAO_MAP_KEY=여기에_발급받은_키
