# Ji-kku 프론트엔드(Next.js) 환경변수 예시
# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요.
# Next.js는 NEXT_PUBLIC_ 접두사가 붙은 변수만 브라우저에 노출합니다.
# (접두사가 없으면 서버 사이드에서만 접근 가능)
#
# ⚠️ 실제 키/토큰/비밀번호는 이 파일(.env.example)에 절대 넣지 마세요.
#    값은 .env.local 에만 작성하며, .env.local 은 커밋 금지입니다.

# 백엔드 API 주소 (버전 프리픽스 /api/v1 포함, 예: https://api.ji-kku.com/api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 카카오 로그인 client_id — developers.kakao.com 의 "REST API 키"를 넣습니다.
# (같은 콘솔의 JavaScript 키와는 다른 값이니 헷갈리지 마세요)
# features/login/components/Login.tsx 가 authorize 요청에 씁니다.
# OAuth client_id 는 원래 공개되는 값이라 NEXT_PUBLIC_ 로 둡니다.
# ⚠️ Client Secret 은 백엔드 몫이며 프론트에 절대 넣지 마세요.
NEXT_PUBLIC_KAKAO_CLIENT_ID=
